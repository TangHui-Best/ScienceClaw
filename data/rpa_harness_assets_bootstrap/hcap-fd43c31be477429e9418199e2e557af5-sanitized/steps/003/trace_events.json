      "code": "async def run(page, results):\n    # Locate the \"About\" heading based on snapshot evidence\n    about_heading = page.locator(\"text=About\").first\n    \n    # Navigate to the container (usually a div or li in the BorderGrid)\n    container = about_heading.locator('xpath=..')\n    \n    # Attempt to find the description paragraph (<p>) within the container\n    desc_element = container.locator('p').first\n    \n    if await desc_element.count() > 0:\n        content = await desc_element.inner_text()\n    else:\n        # Fallback: get all text in the container and remove the \"About\" title\n        full_text = await container.inner_text()\n        content = full_text.replace(\"About\", \"\").strip()\n        \n    return {\"about_content\": content}",
